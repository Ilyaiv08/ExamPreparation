# Строка подключения к базе. По умолчанию — файл SQLite рядом с проектом.
# Для PostgreSQL: замените provider в prisma/schema.prisma на "postgresql"
# и укажите DATABASE_URL="postgresql://user:password@localhost:5432/exam_preparation"
DATABASE_URL="file:./dev.db"

# Секрет для подписи JWT-сессии. ОБЯЗАТЕЛЬНО замените на свой случайный.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Пароль администратора, который создаёт `npm run db:seed`.
# Без этой переменной будет использован admin12345 — только для локальной разработки.
ADMIN_PASSWORD=""
